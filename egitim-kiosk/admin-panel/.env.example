# Bu dosyayı .env.local adıyla kopyalayıp doldurun (Firebase konsolu → Proje ayarları → Web uygulaması).
# Bu değerler gizli değildir; güvenliği backend/firestore.rules sağlar.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
VITE_SCHOOL_ID=ornek-anadolu-lisesi
# firestore.rules içindeki listeyle aynı olmalı
VITE_ADMIN_EMAILS=yonetici@okulunuz.k12.tr
