rules_version = '2';

// Roller Firebase Auth "custom claims" ile taşınır:
//   yönetici (yalnızca siz) : { role: 'admin', schoolId }                 ← ilk-yonetici betiği atar
//   öğrenci cihazı          : { role: 'student', schoolId, studentId }    ← enrollStudent fonksiyonu atar
//
// Öğrenci kendi izin listesini ASLA değiştiremez; yalnızca kendi durumunu, uygulama envanterini
// yazabilir ve kendi adına "BEKLEMEDE" istek oluşturabilir.
service cloud.firestore {
  match /databases/{db}/documents {

    function claims()           { return request.auth.token; }
    function signedIn()         { return request.auth != null; }
    function isAdmin(s)         { return signedIn() && claims().role == 'admin' && claims().schoolId == s; }
    function isStudent(s)       { return signedIn() && claims().role == 'student' && claims().schoolId == s; }
    function isThisStudent(s, id) { return isStudent(s) && claims().studentId == id; }
    function onlyChanges(keys)  { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /schools/{s} {
      allow read, write: if isAdmin(s);

      // Okul saatleri, tatil/duraklatma, varsayılan izinli Android uygulamaları
      match /config/{doc} {
        allow read: if isAdmin(s) || (isStudent(s) && doc == 'settings');
        allow write: if isAdmin(s);
      }

      match /students/{id} {
        allow read: if isAdmin(s) || isThisStudent(s, id);
        allow update: if isAdmin(s)
                      || (isThisStudent(s, id)
                          && onlyChanges(['inventory', 'inventoryUpdatedAt', 'status', 'fcmToken']));
        allow create: if false;          // yalnızca enrollStudent
        allow delete: if isAdmin(s);
      }

      match /requests/{r} {
        allow read: if isAdmin(s) || (isStudent(s) && resource.data.studentId == claims().studentId);
        allow create: if isStudent(s)
                      && request.resource.data.studentId == claims().studentId
                      && request.resource.data.status == 'PENDING'
                      && request.resource.data.appKey is string
                      && request.resource.data.appKey.size() < 200
                      && request.resource.data.appLabel is string
                      && request.resource.data.appLabel.size() < 80
                      && request.resource.data.keys().hasOnly(
                           ['studentId', 'studentName', 'className', 'platform', 'appKey',
                            'appLabel', 'labelVerified', 'note', 'status', 'createdAt']);
        allow update, delete: if isAdmin(s);
      }

      match /enrollmentCodes/{c} {
        allow read, write: if isAdmin(s);
      }
    }
  }
}
