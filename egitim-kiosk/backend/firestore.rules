rules_version = '2';

// Sunucu kodu (Cloud Functions) YOK: tüm güvenlik bu dosyadadır. Firebase'in ücretsiz
// (Spark) planında çalışır.
//
//   Yönetici : Google ile giriş yapmış, e-postası aşağıdaki listede olan hesap.
//   Öğrenci  : Uygulamanın açtığı anonim oturum. Öğrenci kaydının belge kimliği = oturum uid'i,
//              bu yüzden her tablet yalnızca kendi kaydına dokunabilir.
service cloud.firestore {
  match /databases/{db}/documents {

    // >>> KENDİ E-POSTANIZI YAZIN (birden fazla yönetici için listeye ekleyin) <<<
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in ['yonetici@okulunuz.k12.tr'];
    }

    function signedIn() { return request.auth != null; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /schools/{s} {
      allow read, write: if isAdmin();

      // Okul saatleri, duraklatma, herkese açık Android uygulamaları
      match /config/{doc} {
        allow read: if isAdmin() || (signedIn() && doc == 'settings');
        allow write: if isAdmin();
      }

      // Kayıt kodları: öğrenci yalnızca bildiği kodu tek tek okuyabilir, listeleyemez.
      match /enrollmentCodes/{code} {
        allow get: if signedIn();
        allow list, write: if isAdmin();
      }

      match /students/{uid} {
        allow read: if isAdmin() || request.auth.uid == uid;

        // Kayıt: geçerli ve süresi dolmamış bir kodla, boş izinlerle, kendi uid'i altında.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(
               ['name', 'className', 'platform', 'enrollCode', 'consentVersion',
                'allowed', 'grants', 'labels', 'inventory', 'status', 'enrolledAt'])
          && request.resource.data.allowed.size() == 0
          && request.resource.data.grants.size() == 0
          && request.resource.data.name is string && request.resource.data.name.size() >= 3
          && request.resource.data.name.size() <= 60
          && request.resource.data.platform in ['android', 'ios']
          && exists(/databases/$(db)/documents/schools/$(s)/enrollmentCodes/$(request.resource.data.enrollCode))
          && get(/databases/$(db)/documents/schools/$(s)/enrollmentCodes/$(request.resource.data.enrollCode)).data.expiresAt > request.time
          && request.resource.data.className == get(/databases/$(db)/documents/schools/$(s)/enrollmentCodes/$(request.resource.data.enrollCode)).data.className;

        // Öğrenci kendi izin listesini DEĞİŞTİREMEZ; yalnızca durumunu ve uygulama listesini yazar.
        allow update: if isAdmin()
          || (request.auth.uid == uid && onlyChanges(['inventory', 'inventoryUpdatedAt', 'status']));
        allow delete: if isAdmin();
      }

      match /requests/{r} {
        allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.studentId == request.auth.uid
          && exists(/databases/$(db)/documents/schools/$(s)/students/$(request.auth.uid))
          && request.resource.data.status == 'PENDING'
          && request.resource.data.appKey is string && request.resource.data.appKey.size() < 200
          && request.resource.data.appLabel is string && request.resource.data.appLabel.size() < 80
          && request.resource.data.keys().hasOnly(
               ['studentId', 'studentName', 'className', 'platform', 'appKey',
                'appLabel', 'labelVerified', 'note', 'status', 'createdAt']);
        allow update, delete: if isAdmin();
      }
    }
  }
}
