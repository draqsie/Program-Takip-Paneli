rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function inSchool(s) { return request.auth != null && request.auth.token.schoolId == s; }
    function isStaff(s)  { return inSchool(s) && request.auth.token.role in ['teacher', 'admin']; }

    // Kitaplar: okulun tüm cihazları okur, öğretmenler yükler.
    match /okullar/{s}/kitaplar/{file=**} {
      allow read: if inSchool(s);
      allow write: if isStaff(s) && request.resource.contentType == 'application/pdf'
                   && request.resource.size < 200 * 1024 * 1024;
    }

    // APK deposu (AppInstaller buradan indirir). İndirme URL'si için getDownloadURL kullanın.
    match /okullar/{s}/apk/{file=**} {
      allow read: if inSchool(s);
      allow write: if inSchool(s) && request.auth.token.role == 'admin';
    }

    // Öğrenci teslimleri: cihaz yalnızca kendi klasörüne yazar, öğretmenler okur.
    match /teslimler/{s}/{deviceId}/{file} {
      allow create: if inSchool(s) && request.auth.token.role == 'device'
                    && request.auth.token.deviceId == deviceId
                    && request.resource.contentType == 'application/pdf'
                    && request.resource.size < 100 * 1024 * 1024;
      allow read: if isStaff(s);
    }
  }
}
